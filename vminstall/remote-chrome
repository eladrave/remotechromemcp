#!/usr/bin/env bash
set -euo pipefail

if [[ -n ${REMOTE_CHROME_TEST_ROOT:-} ]]; then
  install_root="$(realpath -m -- "$REMOTE_CHROME_TEST_ROOT")/opt/remotechromemcp"
else
  install_root=/opt/remotechromemcp
fi
current="$install_root/current"

for library in common wizard config release activate management; do
  library_path="$current/vminstall/lib/$library.sh"
  [[ -f $library_path && ! -L $library_path ]] || {
    printf 'ERROR: installed management library is unavailable: %s\n' \
      "$library" >&2
    exit 69
  }
  # shellcheck disable=SC1090
  source "$library_path"
done

vm_init_paths
vm_management_dispatch "${1:-}" "${@:2}"
